# Pegatinas NFC Studio — variables de entorno
# Copia a .env.local y rellena. Sin KIE_API_KEY la app corre en modo mock.

# Obligatoria para Kie real (gpt-image-2-image-to-image)
KIE_API_KEY=

# Opcional (default https://api.kie.ai/api/v1/jobs)
# KIE_API_BASE=https://api.kie.ai/api/v1/jobs

# Modelo (default gpt-image-2-image-to-image)
# KIE_MODEL=gpt-image-2-image-to-image

# URL pública de esta app (callbacks + absolutizar proxies de imágenes)
# Ejemplo local con tunnel: https://xxxx.ngrok.app
URL_PUBLICA=

# Icono NFC global (URL https absoluta enviada siempre a Kie)
ICONO_NFC_URL=
